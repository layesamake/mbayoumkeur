<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' · ' : '' %><%= siteName %></title>
<link rel="stylesheet" href="/style.css"></head>
<body class="bg-white text-slate-800 font-sans antialiased" data-shops="<%= JSON.stringify(shops) %>" data-site="<%= siteName %>">
<header class="border-b sticky top-0 bg-white/95 backdrop-blur z-10">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center gap-4 flex-wrap">
    <a href="/" class="text-xl font-bold text-leaf-700">🌿 <%= siteName %></a>
    <nav class="flex gap-4 text-sm ml-auto order-3 md:order-2 w-full md:w-auto overflow-x-auto">
      <a class="hover:text-leaf-600" href="/boutique">Boutique</a>
      <% categories.slice(0,4).forEach(c => { %><a class="hover:text-leaf-600 whitespace-nowrap" href="/boutique?categorie=<%= encodeURIComponent(c.name) %>"><%= c.name %></a><% }) %>
      <a class="hover:text-leaf-600 whitespace-nowrap" href="/notre-histoire">Notre histoire</a>
      <a class="hover:text-leaf-600" href="/nous-contacter">Contact</a>
    </nav>
    <form action="/boutique" class="order-2 md:order-3"><input name="q" value="<%= q %>" placeholder="Rechercher…" class="border rounded-full px-4 py-1.5 text-sm w-40 focus:outline-none focus:ring-2 focus:ring-leaf-600"></form>
    <a href="/ma-selection" class="order-2 md:order-4 relative bg-leaf-600 hover:bg-leaf-700 text-white text-sm px-4 py-1.5 rounded-full">Ma sélection <span id="cart-count" class="ml-1 bg-white text-leaf-700 rounded-full px-1.5 text-xs font-bold">0</span></a>
  </div>
</header>
<main>
