<%- include('_head', {title:'Conseils d’entretien', description:'Arroser, exposer, planter, cultiver en pot : les conseils d’entretien de Mbayoumkeur pour réussir vos plants, et les conseils de chaque plante.'}) %>

<section class="max-w-6xl mx-auto px-5 pt-10 md:pt-16">
  <h1 class="font-display font-extrabold text-4xl md:text-6xl text-leaf-900 leading-[1.02] tracking-tight max-w-[18ch]">Conseils d’entretien</h1>
  <p class="mt-5 text-lg md:text-xl text-slate-700 leading-relaxed max-w-[50ch]">Arrosage, soleil, sol, plantation : les gestes qui font réussir un plant, adaptés à la chaleur du Sénégal. Pour une plante précise, ses conseils sont plus bas.</p>
  <nav aria-label="Sujets" class="mt-7 flex flex-wrap gap-2.5">
    <a href="#gestes" class="inline-flex items-center min-h-11 px-5 rounded-full border-2 border-leaf-600 text-leaf-900 font-semibold hover:bg-leaf-600 hover:text-white transition">Les gestes essentiels</a>
    <% if (nbPlantes) { %><a href="#par-plante" class="inline-flex items-center min-h-11 px-5 rounded-full border-2 border-leaf-600 text-leaf-900 font-semibold hover:bg-leaf-600 hover:text-white transition">Conseils par plante</a><% } %>
  </nav>
</section>

<section id="gestes" class="max-w-6xl mx-auto px-5 mt-12 md:mt-16 scroll-mt-24">
  <h2 class="font-display font-extrabold text-3xl md:text-4xl text-leaf-900">Les gestes essentiels</h2>
  <p class="mt-2 text-slate-600 max-w-[56ch]">Des repères valables pour la plupart des légumes, herbes aromatiques et arbres fruitiers. Chaque plante a ses exigences : la fiche de la plante prime.</p>
  <div class="mt-8 grid gap-4 md:grid-cols-2 md:gap-6">
    <% gestes.forEach((g, i) => { %>
    <article id="<%= g.id %>" class="scroll-mt-24 rounded-3xl p-6 md:p-8 <%= i % 3 === 0 ? 'bg-leaf-50 border border-leaf-100' : i % 3 === 1 ? 'bg-white border-2 border-leaf-100' : 'bg-sun-soft/40 border border-sun-soft' %>">
      <div class="flex items-center gap-3">
        <span class="shrink-0 flex items-center justify-center w-12 h-12 rounded-full bg-white text-2xl" aria-hidden="true"><%= g.icone %></span>
        <h3 class="font-display font-extrabold text-2xl text-leaf-900 leading-tight"><%= g.titre %></h3>
      </div>
      <p class="mt-3 font-semibold text-leaf-700"><%= g.resume %></p>
      <ul class="mt-3 space-y-2.5 text-slate-700 leading-relaxed">
        <% g.points.forEach((pt) => { %><li class="flex gap-2.5"><span class="mt-2 shrink-0 w-2 h-2 rounded-full bg-leaf-600" aria-hidden="true"></span><span><%= pt %></span></li><% }) %>
      </ul>
    </article>
    <% }) %>
  </div>
</section>

<% if (nbPlantes) { %>
<section id="par-plante" class="max-w-3xl mx-auto px-5 mt-16 md:mt-24 scroll-mt-24">
  <h2 class="font-display font-extrabold text-3xl md:text-4xl text-leaf-900">Conseils par plante</h2>
  <p class="mt-2 text-slate-600">Les conseils donnés par nos producteurs pour chaque plante de la boutique.</p>
  <% parUnivers.forEach((u) => { %>
  <h3 class="mt-8 font-display font-bold text-xl text-leaf-700"><%= u.name %></h3>
  <div class="mt-3 space-y-3">
    <% u.plantes.forEach((p) => { %>
    <details class="group rounded-2xl border-2 border-leaf-100 bg-leaf-50 open:bg-white open:border-leaf-600 transition-colors">
      <summary class="flex items-center justify-between gap-4 cursor-pointer min-h-14 px-5 py-3 list-none [&::-webkit-details-marker]:hidden font-display font-bold text-lg md:text-xl text-leaf-900 leading-snug rounded-2xl">
        <span><%= p.name %><% if (p.scientific) { %> <span class="font-sans font-normal italic text-base text-slate-600">(<%= p.scientific %>)</span><% } %></span>
        <svg class="shrink-0 w-6 h-6 text-leaf-600 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="px-5 pb-5 text-slate-700 text-lg leading-relaxed max-w-[62ch]">
        <% p.conseils.split(/\n+/).filter(Boolean).forEach((par) => { %><p class="mb-3"><%= par %></p><% }) %>
        <a href="/produit/<%= p.slug %>" class="inline-flex items-center min-h-11 font-semibold text-leaf-700 underline underline-offset-4 hover:text-leaf-900">Voir la fiche <span class="sr-only"><%= p.name %></span></a>
      </div>
    </details>
    <% }) %>
  </div>
  <% }) %>
</section>
<% } %>

<section class="max-w-3xl mx-auto px-5 mt-14 md:mt-20">
  <div class="rounded-3xl bg-leaf-900 text-white p-7 md:p-10">
    <h2 class="font-display font-extrabold text-2xl md:text-3xl">Une plante qui ne va pas bien&nbsp;?</h2>
    <p class="mt-2 text-leaf-100 text-lg max-w-[46ch]">Envoyez-nous une photo par WhatsApp en décrivant ce que vous voyez : nous vous conseillons.</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <% shops.forEach((s) => { const wa = 'https://wa.me/' + s.number + '?text=' + encodeURIComponent('Bonjour ' + siteName + ', j’ai une question sur l’entretien de ma plante : '); %>
      <a href="<%= wa %>" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 min-h-12 px-6 rounded-full bg-[#25D366] text-leaf-900 text-lg font-bold hover:brightness-95 transition"><%- include('_icon', {name:'chat'}) %><%= s.name %><span class="sr-only"> sur WhatsApp (s’ouvre dans un nouvel onglet)</span></a>
      <% }) %>
      <a href="/faq" class="inline-flex items-center justify-center min-h-12 px-6 rounded-full border-2 border-white/60 text-lg font-semibold hover:bg-white/10 transition">Questions fréquentes</a>
    </div>
  </div>
</section>
<%- include('_foot') %>
