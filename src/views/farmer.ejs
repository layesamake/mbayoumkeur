<meta name="robots" content="noindex,nofollow">
<meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Mes plantes"><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Espace agriculteur · <%= siteName %></title>
<link rel="manifest" href="/agriculteur/manifest.webmanifest">
