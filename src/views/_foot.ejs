</main>
<%# Pied de page : les sillons du logo qui montent vers le vert profond %>
<footer class="relative bg-leaf-900 text-leaf-100 mt-24 md:mt-32">
  <svg class="absolute inset-x-0 top-0 w-full h-10 md:h-16 -translate-y-[calc(100%-1px)]" viewBox="0 0 1440 96" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 52 C240 8 480 96 720 50 S1200 6 1440 52 V96 H0Z" fill="#479a05"/>
    <path d="M0 74 C260 30 520 108 780 68 S1220 32 1440 74 V96 H0Z" fill="#04481a"/>
  </svg>

  <div class="max-w-6xl mx-auto px-5 pt-6 pb-10 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-3">
      <div class="flex items-center gap-4">
        <span class="shrink-0 w-16 h-16 rounded-full bg-sun-soft flex items-center justify-center" aria-hidden="true"><img src="/img/emblem.png" alt="" width="420" height="420" loading="lazy" class="w-12 h-12 object-contain"></span>
        <p class="font-display font-extrabold text-3xl text-white leading-none"><%= siteName %></p>
      </div>
      <p class="mt-4 text-leaf-100 text-base leading-relaxed max-w-[34ch]">Plants, arbres fruitiers et légumes. Vous choisissez, vous commandez sur WhatsApp, nous livrons.</p>
      <div class="mt-5 flex gap-3">
        <a href="<%= instagram %>" target="_blank" rel="noopener" class="w-12 h-12 inline-flex items-center justify-center rounded-full border-2 border-white/40 text-white hover:bg-white hover:text-leaf-900 transition"><%- include('_icon', {name:'instagram'}) %><span class="sr-only">Instagram (s’ouvre dans un nouvel onglet)</span></a>
        <a href="<%= facebook %>" target="_blank" rel="noopener" class="w-12 h-12 inline-flex items-center justify-center rounded-full border-2 border-white/40 text-white hover:bg-white hover:text-leaf-900 transition"><%- include('_icon', {name:'facebook'}) %><span class="sr-only">Facebook (s’ouvre dans un nouvel onglet)</span></a>
      </div>
    </div>

    <nav aria-label="Pied de page" class="md:col-span-2">
      <h2 class="font-display font-bold text-lg text-white">Explorer</h2>
      <ul class="mt-2">
        <% [['/boutique','Boutique'],['/ma-selection','Ma sélection'],['/notre-histoire','Notre histoire'],['/nous-contacter','Contact'],['/agriculteur','Espace agriculteurs']].forEach(([href, label]) => { const farmer = href === '/agriculteur'; %>
        <li><a href="<%= href %>" <%- cur(href) %><%- farmer ? ' rel="nofollow"' : '' %> class="inline-flex items-center min-h-11 hover:underline underline-offset-4 aria-[current=page]:text-white aria-[current=page]:font-semibold <%= farmer ? 'text-sun-soft font-semibold' : '' %>"><%= label %></a></li>
        <% }) %>
      </ul>
    </nav>

    <nav aria-label="Univers de la boutique" class="md:col-span-3">
      <h2 class="font-display font-bold text-lg text-white">Nos univers</h2>
      <ul class="mt-2">
        <% categories.forEach(c => { %><li><a href="/boutique?categorie=<%= encodeURIComponent(c.name) %>" class="inline-flex items-center min-h-11 hover:underline underline-offset-4"><%= c.name %></a></li><% }) %>
      </ul>
    </nav>

    <div class="md:col-span-4">
      <h2 class="font-display font-bold text-lg text-white">Nous joindre</h2>
      <ul class="mt-3 space-y-5">
        <% shops.forEach(s => { %>
        <li>
          <p class="font-semibold text-white"><%= s.name %></p>
          <div class="mt-1 flex flex-wrap items-center gap-x-5">
            <a href="tel:+<%= s.number %>" class="inline-flex items-center gap-2 min-h-11 font-bold text-lg tabular-nums hover:underline underline-offset-4"><%- include('_icon', {name:'phone'}) %><%= s.display %></a>
            <a href="https://wa.me/<%= s.number %>" target="_blank" rel="noopener" class="inline-flex items-center gap-2 min-h-11 text-sun-soft font-semibold hover:underline underline-offset-4"><%- include('_icon', {name:'chat'}) %>WhatsApp<span class="sr-only"> <%= s.name %> (s’ouvre dans un nouvel onglet)</span></a>
          </div>
        </li>
        <% }) %>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="max-w-6xl mx-auto px-5 py-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-1 text-sm text-leaf-100">
      <p>© <%= new Date().getFullYear() %> <%= siteName %></p>
      <p>Commande par WhatsApp, sans paiement en ligne.</p>
    </div>
  </div>
</footer>
<nav aria-label="Navigation mobile" class="md:hidden fixed bottom-0 inset-x-0 z-30 bg-white border-t grid grid-cols-4 text-[13px] pb-[env(safe-area-inset-bottom)]">
  <a href="/" <%- cur('/') %> class="flex flex-col items-center justify-center h-16 gap-0.5 text-slate-600 aria-[current=page]:text-leaf-700 aria-[current=page]:font-bold"><span class="text-xl" aria-hidden="true">🏠</span>Accueil</a>
  <a href="/boutique" <%- cur('/boutique') %> class="flex flex-col items-center justify-center h-16 gap-0.5 text-slate-600 aria-[current=page]:text-leaf-700 aria-[current=page]:font-bold"><span class="text-xl" aria-hidden="true">🪴</span>Boutique</a>
  <a href="/ma-selection" <%- cur('/ma-selection') %> class="flex flex-col items-center justify-center h-16 gap-0.5 text-slate-600 relative aria-[current=page]:text-leaf-700 aria-[current=page]:font-bold"><span class="text-xl" aria-hidden="true">🧺</span>Sélection<span class="cart-count absolute top-2 left-1/2 ml-2 bg-leaf-600 text-white rounded-full min-w-5 text-center px-1 text-xs font-bold">0</span></a>
  <a href="/nous-contacter" <%- cur('/nous-contacter') %> class="flex flex-col items-center justify-center h-16 gap-0.5 text-slate-600 aria-[current=page]:text-leaf-700 aria-[current=page]:font-bold"><span class="text-xl" aria-hidden="true">📞</span>Contact</a>
</nav>
<div id="live" class="sr-only" role="status" aria-live="polite"></div>
<script src="/app.js" defer></script>
<% if (typeof extraScript !== 'undefined') { %><script src="<%= extraScript %>" defer></script><% } %>
</body></html>
