<%- include('_head', {title: p.name}) %>
<div class="max-w-5xl mx-auto px-4 mt-8">
<p class="text-sm text-slate-500"><a href="/boutique" class="hover:underline">Boutique</a> › <a class="hover:underline" href="/boutique?categorie=<%= encodeURIComponent(p.category) %>"><%= p.category %></a></p>
<div class="grid md:grid-cols-2 gap-8 mt-4">
<div class="rounded-2xl w-full bg-leaf-50 aspect-square overflow-hidden flex items-center justify-center text-8xl">
<% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.name %>" class="w-full h-full object-cover"><% } else { %>🪴<% } %></div>
<div><h1 class="text-3xl font-bold text-leaf-900"><%= p.name %></h1><p class="text-leaf-600 mt-1"><%= p.category %></p>
<p class="text-2xl mt-4 font-semibold"><%= p.price ? fcfa(p.price) : 'Prix sur demande' %><% if (p.price && p.unit) { %><span class="text-base font-normal text-slate-500"> / <%= p.unit %></span><% } %></p>
<div class="mt-5 text-slate-600 leading-relaxed [&_p]:mb-3"><%- p.html %></div>
<% if (p.available) { %><button type="button" data-add data-slug="<%= p.slug %>" data-name="<%= p.name %>" data-price="<%= p.price %>" data-unit="<%= p.unit %>" class="mt-6 bg-leaf-600 hover:bg-leaf-700 text-white font-semibold px-8 py-3 rounded-full transition">+ Ajouter à ma sélection</button>
<% } else { %><p class="mt-6 text-slate-500">Ce produit est actuellement indisponible.</p><% } %></div></div>
<% if (related.length) { %><h2 class="text-xl font-bold text-leaf-900 mt-14 mb-4">Dans la même catégorie</h2>
<div class="grid grid-cols-2 md:grid-cols-4 gap-4"><% related.forEach(p => { %><%- include('_card', {p}) %><% }) %></div><% } %>
</div>
<%- include('_foot') %>
